{
  "name": "lordaeron-tabletop",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && npm run check:server && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "dev:server": "tsx watch server/dev.ts",
    "simulate": "tsx scripts/simulate.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "check:render": "tsx scripts/check-render.ts",
    "render:map": "tsx scripts/render-map.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@upstash/redis": "^1.39.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
