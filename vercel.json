{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":"vite",
 "buildCommand":"npm run build",
 "outputDirectory":"dist",
 "functions":{"api/game.ts":{"maxDuration":30},"api/ws.ts":{"maxDuration":300}},
 "headers":[
  {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]},
  {"source":"/assets/:file([^/]+\\.(?:js|css|woff|woff2))","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
  {"source":"/assets/:path((?!(?:[^/]+\\.(?:js|css|woff|woff2))$).*)","headers":[{"key":"Cache-Control","value":"public, max-age=86400"}]}
 ]
}
